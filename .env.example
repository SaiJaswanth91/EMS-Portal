# ==================================================
# ENTERPRISE EMPLOYEE & LEAVE MANAGEMENT SYSTEM (EELMS)
# Environment Configuration Template
# ==================================================

# Django Settings
DJANGO_SECRET_KEY=django-insecure-eelms-local-dev-secret-key-change-in-production-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL with SQLite fallback for initial bootstrapping)
USE_POSTGRES=False
DATABASE_NAME=eelms_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Email Backend Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EELMS System <noreply@eelms.com>
